{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WCKD",
  "version": "0.1.0",
  "identifier": "com.wckd.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WCKD",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "backgroundColor": "#FFFFFF",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "WCKD",
    "shortDescription": "Gerenciador financeiro pessoal",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false
      }
    }
  }
}
